# Mac 3 / Backend A / TCP 3001 -- STRICT ruleset (Extension C demo)
# Only the primary edge (Mac 2) may reach 3001 over the network.
# Mac 3 itself (loopback or its own LAN IP) is not a network client and stays allowed.
# TEMPLATE: replace SET_MAC2_IP_FROM_S0 and SET_MAC3_IP_FROM_S0 with the verified S0 values before loading.
# With the placeholders still in place this file fails to parse, so it cannot be loaded by mistake.
# Load only into the project anchor:  sudo pfctl -a com.apple/nova -f MAC_3/firewall/mac3-backend-a.strict.pf
mac2 = "SET_MAC2_IP_FROM_S0"     # primary edge
mac3 = "SET_MAC3_IP_FROM_S0"     # this Mac (self)
pass  in quick on lo0 all
pass  in quick proto tcp from $mac3 to any port 3001
pass  in quick proto tcp from $mac2 to any port 3001
block drop in quick proto tcp from any to any port 3001
